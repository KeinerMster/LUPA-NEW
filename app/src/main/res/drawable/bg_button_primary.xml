<?xml version="1.0" encoding="utf-8"?>
<!-- Botón principal: ámbar con gradiente sutil y esquinas redondeadas -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brand_amber_dark"
                android:endColor="@color/brand_amber_dark"
                android:angle="270" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/brand_amber_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brand_amber_light"
                android:endColor="@color/brand_amber"
                android:angle="270" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/brand_amber_dark" />
        </shape>
    </item>
</selector>
