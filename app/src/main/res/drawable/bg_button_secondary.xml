<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario: superficie oscura con borde sutil -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_4" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
