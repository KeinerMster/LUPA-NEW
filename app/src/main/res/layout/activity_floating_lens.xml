<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🪟"
            android:textSize="48sp" />

        <TextView
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/floating_lens_title"
            android:textColor="@color/brand_amber" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/brand_amber" />

        <!-- Estado -->
        <LinearLayout
            style="@style/CardSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/floatingStatus"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/brand_amber" />

            <TextView
                android:id="@+id/floatingZoom"
                style="@style/Text.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center" />
            
            <TextView
                android:id="@+id/floatingDiag"
                style="@style/Text.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/brand_amber" />

        </LinearLayout>

        <!-- Instrucciones -->
        <LinearLayout
            style="@style/CardSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cómo usarla" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/floating_lens_help" />

        </LinearLayout>

        <!-- Botones de acción -->
        <Button
            android:id="@+id/btnStartFloating"
            style="@style/HugeButton"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:text="@string/floating_lens_start" />

        <Button
            android:id="@+id/btnStopFloating"
            style="@style/DangerButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:text="@string/floating_lens_stop" />

        <!-- Tamaño -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/floating_lens_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnFloatingSizeSmall"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="🔍&#10;Pequeña" />

            <Button
                android:id="@+id/btnFloatingSizeMedium"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="🔍&#10;Mediana" />

            <Button
                android:id="@+id/btnFloatingSizeLarge"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="🔍&#10;Grande" />

        </LinearLayout>

        <!-- Aumento -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/floating_lens_zoom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnFloatingZoomOut"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="−&#10;Menos aumento" />

            <Button
                android:id="@+id/btnFloatingZoomIn"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="+&#10;Más aumento" />

        </LinearLayout>

        <Button
            android:id="@+id/btnFloatingHelp"
            style="@style/BigButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/floating_lens_help_btn" />

    </LinearLayout>
</ScrollView>
