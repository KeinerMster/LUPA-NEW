<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_0">

    <!-- Contenido central -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icono de lupa -->
        <TextView
            android:id="@+id/splashIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="80sp" />

        <!-- Nombre de la app -->
        <TextView
            android:id="@+id/splashTitle"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/brand_amber"
            android:textSize="42sp" />

        <!-- Línea decorativa -->
        <View
            android:id="@+id/splashLine"
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:background="@color/brand_amber" />

        <!-- Dedicatoria -->
        <TextView
            android:id="@+id/splashDedication"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/dedication_short"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:lineSpacingExtra="8dp" />

    </LinearLayout>

    <!-- Pie: creada por -->
    <TextView
        android:id="@+id/splashFooter"
        style="@style/Text.BodySecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/created_by"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
